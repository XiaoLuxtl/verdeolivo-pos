// Ruta: prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enum para categorías (más controlado)
enum CategoriaReceta {
  MALTEADA
  ALOE
  SHAKE
  SUPLEMENTO
  OTRO
}

// Enum para unidades de medida
enum UnidadMedida {
  GR  @map("gr")
  ML  @map("ml")
  PZ  @map("pz")
  KG  @map("kg")  
  L   @map("lt")   
}

// Enum para categorías de producto
enum CategoriaProducto {
  ALOE
  TE @map("TÉ")
  MALTEADA
  PROTEINA
  EXTRA
  INSUMO_PESO 
}

model Producto {
  id                    Int                 @id @default(autoincrement())
  sku                   String              @unique
  nombre                String
  sabor                 String?
  proveedor             String?
  precioUnitario        Float
  peso                  Float?
  precioPorUnidad       Float?
  unidad                UnidadMedida        @default(GR)
  descripcion           String?
  stockMinimo           Float?              @default(5)
  descripcionUmbral     String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt // 💡 ¡CAMBIO AÑADIDO!
  categoria             CategoriaProducto   @default(EXTRA)

  inventario            Inventario?
  movimientos           MovimientoInventario[]
  recetaIngredientes    RecetaIngrediente[]
  detallesCompra        DetalleCompra[]     @relation("ProductoDetalleCompra")
  versionesIngredientes RecetaVersionIngrediente[]
}

model Inventario {
  id             Int          @id @default(autoincrement())
  productoId     Int          @unique
  cantidadActual Float        @default(0)
  unidad         UnidadMedida
  actualizadoEn  DateTime     @updatedAt
  producto       Producto     @relation(fields: [productoId], references: [id], onDelete: Cascade)
}

model MovimientoInventario {
  id            Int      @id @default(autoincrement())
  productoId    Int
  tipo          String
  categoria     String
  cantidad      Float
  costoUnitario Float?
  fecha         DateTime @default(now())
  referencia    String?
  notas         String?
  ventaRef      Int?
  motivoMerma   String?
  venta         Venta?   @relation("VentaMovimientos", fields: [ventaRef], references: [id], onDelete: SetNull)
  producto      Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([categoria, fecha])
}

model Compra {
  id        Int             @id @default(autoincrement())
  fecha     DateTime        @default(now())
  proveedor String
  total     Float
  notas     String?
  detalles  DetalleCompra[]
}

model DetalleCompra {
  id            Int      @id @default(autoincrement())
  compraId      Int
  productoId    Int
  cantidad      Float
  costoUnitario Float
  subtotal      Float
  compra        Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  producto      Producto @relation("ProductoDetalleCompra", fields: [productoId], references: [id], onDelete: Restrict)
}

model Receta {
  id                    Int                 @id @default(autoincrement())
  nombre                String
  categoria             CategoriaReceta     @default(OTRO)
  descripcion           String?
  precioVenta           Float
  imagen                String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt // 💡 ¡CAMBIO AÑADIDO!
  versiones             RecetaVersion[]
  ingredientes          RecetaIngrediente[]
}

model RecetaIngrediente {
  id              Int             @id @default(autoincrement())
  recetaId        Int
  productoId      Int
  cantidad        Float
  unidad          UnidadMedida
  costoUnitario   Float?          // 💡 ¡CAMBIO CRUCIAL AÑADIDO!
  producto        Producto        @relation(fields: [productoId], references: [id], onDelete: Cascade)
  receta          Receta          @relation(fields: [recetaId], references: [id], onDelete: Cascade)
}

model RecetaVersion {
  id                    Int                      @id @default(autoincrement())
  recetaId              Int
  version               Int                      // Número de versión (1, 2, 3...)
  nombre                String
  categoria             CategoriaReceta
  descripcion           String?
  precioVenta           Float
  imagen                String?
  costoTotal            Float?                   // Costo total calculado de ingredientes
  createdAt             DateTime                 @default(now())
  receta                Receta                   @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  detallesVenta         DetalleVenta[]
  ingredientes          RecetaVersionIngrediente[]

  @@unique([recetaId, version])
}

model RecetaVersionIngrediente {
  id              Int             @id @default(autoincrement())
  recetaVersionId Int
  productoId      Int
  cantidad        Float
  unidad          UnidadMedida
  costoUnitario   Float           // Costo unitario en el momento de la versión
  costoTotal      Float           // cantidad * costoUnitario
  producto        Producto        @relation(fields: [productoId], references: [id], onDelete: Cascade)
  recetaVersion   RecetaVersion   @relation(fields: [recetaVersionId], references: [id], onDelete: Cascade)
}

model Venta {
  id                     Int                    @id @default(autoincrement())
  fecha                  DateTime               @default(now())
  subtotal               Float
  descuento              Float                  @default(0)
  tipoDescuento          String?
  valorDescuentoOriginal Float?
  total                  Float
  recibido               Float
  cambio                 Float
  metodoPago             String                 @default("efectivo")
  notas                  String?
  detalles               DetalleVenta[]
  movimientos            MovimientoInventario[] @relation("VentaMovimientos")

  @@index([fecha])
}

model DetalleVenta {
  id                Int            @id @default(autoincrement())
  ventaId           Int
  recetaVersionId   Int            // Referencia a la versión específica de la receta
  cantidad          Int
  precioUnitario    Float
  costoUnitario     Float?         // Costo unitario de la receta en el momento de la venta
  subtotal          Float
  movimientoRef     String?
  recetaVersion     RecetaVersion  @relation(fields: [recetaVersionId], references: [id], onDelete: Restrict)
  venta             Venta          @relation(fields: [ventaId], references: [id], onDelete: Cascade)
}